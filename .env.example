# Variáveis de Ambiente do SGA (Sistema de Gerenciamento de Atendimento)
# NÃO ENVIE O ARQUIVO .env REAL PARA O GITHUB!

# Senha do Banco de Dados PostgreSQL
# Altere para uma senha forte em produção (ex: DB_PASSWORD=Xk8#9mP$21qL!vN)
DB_PASSWORD=sgapassword123!

# Senha do Administrador Padrão (O usuário admin só será criado se não existir)
# Altere para a senha que você deseja usar para o primeiro acesso ao Painel Admin.
# Se deixada em branco, o backend irá gerar uma senha forte aleatória e imprimir no console.
ADMIN_PASSWORD=SuaSenhaAdminForte123!
